+    """Time call(i) per frame; also the longest stretch between OpenCV calls."""
+    orig = {n: getattr(cv2, n) for n in CV_NAMES}
+    marks = []
+
+    def wrap(fn):
+        def w(*a, **k):
+            t0 = time.perf_counter()
+            r = fn(*a, **k)
+            marks.append((t0, time.perf_counter()))
+            return r
