# ==============================================================================
# GLITCH BOOTH RUNTIME ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' in the project root:
#     cp .env.example .env
#
# NOTE: If you change any value in '.env', you MUST restart the booth service:
#     sudo systemctl restart glitchbooth.service
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. IMAGEKIT CLOUD CREDENTIALS (Required)
# ------------------------------------------------------------------------------
# Obtain from your ImageKit.io Dashboard (Developer Options / API Keys)
IK_URL_ENDPOINT = "https://ik.imagekit.io/your_imagekit_id"
IK_PRIVATE_KEY = "private_your_private_api_key_here="
IK_PUBLIC_KEY = "public_your_public_api_key_here="
# ------------------------------------------------------------------------------
# 2. EVENT MODE ROUTING
# ------------------------------------------------------------------------------
# - EVENT MODE: Set to your event slug (e.g., "synthistan2026")
#     Target ImageKit Folder : /booth_captures/synthistan2026
#     Web Landing URL        : https://glitchbooth.online/synthistan2026/p/{timestamp}
#
# - NAKED MODE: Leave empty (EVENT_SLUG="")
#     Target ImageKit Folder : /booth_captures
#     Web Landing URL        : https://glitchbooth.online/p/{timestamp}
#
# CRITICAL CHECKLIST WHEN CHANGING EVENT_SLUG:
# 1. Ensure the folder exists on ImageKit under /booth_captures/<EVENT_SLUG>/
# 2. Ensure EVENT_SLUG matches the slug in the web frontend (event.config.ts)
# 3. Update the receipt header/social text in server.py -> print_booth_receipt()
# 4. Flush pending uploads before switching events:
#        > pending_uploads.txt
EVENT_SLUG = "synthistan2026"

# Base folder name in ImageKit (default: "booth_captures")
IK_BASE_FOLDER = "booth_captures"

# Public website domain for QR codes and landing pages
BASE_DOMAIN = "https://glitchbooth.online"

# ------------------------------------------------------------------------------
# 3. THERMAL RECEIPT PRINT CONTRAST
# ------------------------------------------------------------------------------
# Contrast scaling (alpha) and brightness offset (beta) for cv2.convertScaleAbs
# Recommended presets:
# - Bright daylight / high ambient lighting : ALPHA=1.2, BETA=11
# - Normal indoor lighting                  : ALPHA=1.5, BETA=11
# - Dim venue / night party                 : ALPHA=1.4, BETA=37
PRINT_ALPHA = "1.5"
PRINT_BETA = "11"

# ------------------------------------------------------------------------------
# 4. SYSTEM & LOGGING
# ------------------------------------------------------------------------------
# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL = "INFO"
