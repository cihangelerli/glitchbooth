[Unit]
Description=Glitch Booth Release Candidate 01 (Pygame Kiosk)
After=network.target
Wants=network.target
# CRITICAL: Tells systemd to temporarily stop the login screen on tty1 so it doesn't fight our kiosk
Conflicts=getty@tty1.service

[Service]
Type=simple
WorkingDirectory=/home/glitchbooth/glitch-booth
ExecStart=/home/glitchbooth/glitch-booth/venv/bin/python /home/glitchbooth/glitch-booth/pygame_display.py

# Drop root permissions and run as the standard user
User=glitchbooth
Group=glitchbooth
# Pass through essential hardware access permissions explicitly
SupplementaryGroups=video input audio tty

# Monitor and input device targeting
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

Restart=on-failure
RestartSec=2

Environment=PYTHONUNBUFFERED=1
Environment=SDL_VIDEODRIVER=kmsdrm

ExecStartPre=/bin/sleep 2

[Install]
WantedBy=multi-user.target

